/*
 * Motorola Moto E32 (XT2227-1, "hawaii", board 4h10) - Unisoc UMS9230 / T606
 *
 * Self-contained 7.1 board description.  The board-level DT nodes the
 * vendor-derived 7.1 drivers need are ported from the stock 4.14 DTB so the
 * kernel can boot from its own DTB instead of relying on the bootloader's
 * vendor DTB + dtbo merge.  The drivers keep their vendor-path fallbacks
 * (harmless no-ops on this tree).
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "ums9230.dtsi"
#include "sc2730.dtsi"
#include "lcd_nt36525c_boe_mipi_fhd.dtsi"

/ {
	model = "Motorola Moto E32 (XT2227-1)";
	compatible = "motorola,hawaii", "sprd,ums9230-4h10", "sprd,ums9230";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial1:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		/* measured on the device: 4 GiB with the namespace carve-out */
		reg = <0x0 0x80000000 0x0 0x53f0000>,
		      <0x0 0x85400000 0x0 0xfabff000>;
	};

	reserved-memory {
		logobuffer@9e000000 {
			reg = <0x0 0x9e000000 0x0 0xab0000>;
			/* NOT no-map: diag_stage.h paints this through the
			 * linear map (phys_to_virt) */
		};

		ramoops@fff80000 {
			compatible = "ramoops";
			reg = <0x0 0xfff80000 0x0 0x40000>;
			console-size = <0x8000>;
			record-size = <0x8000>;
			pmsg-size = <0x8000>;
		};
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <4850000>;
		charge-term-current-microamp = <130000>;
		constant-charge-voltage-max-microvolt = <4400000>;
		voltage-min-design-microvolt = <3500000>;
		voltage-max-design-microvolt = <4370000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			wakeup-source;
			debounce-interval = <2>;
			gpios = <&pmic_eic 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			label = "Power Key";
		};

		key-volumeup {
			wakeup-source;
			debounce-interval = <2>;
			gpios = <&pmic_eic 4 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_VOLUMEUP>;
			label = "Volume Up Key";
		};

		key-volumedown {
			wakeup-source;
			debounce-interval = <2>;
			gpios = <&ap_gpio 124 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			label = "Volume Down Key";
		};

		key-google {
			wakeup-source;
			debounce-interval = <2>;
			gpios = <&ap_gpio 126 GPIO_ACTIVE_LOW>;
			linux,code = <249>;
			label = "Google Key";
		};
	};

	usb_cable {
		compatible = "sprd,usb_cable_eint";
		usbcable-gpio = <&ap_gpio 121 GPIO_ACTIVE_LOW>;
		debounce = <250000>;
		status = "okay";
	};
};

&uart0 { status = "okay"; };
&uart1 { status = "okay"; };

/*
 * The PMIC soft reset lives in the sprd-adi driver's qogirl6 variant; the
 * "sprd,ums512-adi" fallback has no ->restart callback and would win the
 * of_match table walk, so drop it here.
 */
&adi_bus {
	compatible = "sprd,qogirl6-adi", "sprd,ums9230-adi";
};

/* Storage */
&ufs {
	status = "okay";
};

/* USB gadget (CDC-ACM serial console on ttyGS0) */
&usb {
	status = "okay";
	dr_mode = "peripheral";
};

&hsphy {
	status = "okay";
	phy-supply = <&vddusb33>;
};

/* Display: DPU -> DSI -> BOE NT36525C panel (DCS table in the /lcds node) */
&disp {
	status = "okay";
};

&dpu {
	status = "okay";
};

&dsi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "sprd,generic-mipi-panel";
		reg = <0>;
		reset-gpios = <&ap_gpio 50 GPIO_ACTIVE_LOW>;
		avdd-gpios = <&ap_gpio 154 GPIO_ACTIVE_LOW>;
		avee-gpios = <&ap_gpio 155 GPIO_ACTIVE_LOW>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

/* GPU */
&gpu {
	status = "okay";
	mali-supply = <&vddgpu>;
};

/* Novatek NT36xxx touch controller on SPI3 (irq/reset on the AP GPIO bank) */
&spi3 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	novatek@0 {
		compatible = "novatek,NVT-ts-spi";
		reg = <0>;
		spi-max-frequency = <9600000>;
		novatek,reset-gpio = <&ap_gpio 145 GPIO_ACTIVE_LOW>;
		novatek,irq-gpio = <&ap_gpio 144 GPIO_ACTIVE_HIGH>;
		novatek,swrst-n8-addr = <0x03f0fe>;
		novatek,spi-rd-fast-addr = <0x03f310>;
	};
};

/* WCN (SC2355 WiFi + BT over SDIO/UART) */
&wcn {
	status = "okay";
	vdd-supply = <&vddwcn>;
	vddwifipa-supply = <&vddwifipa>;
	dcxo1v8-supply = <&vddsim2>;
};

/* Regulators needed by the enabled blocks */
&vddusb33 { regulator-always-on; };
&vddemmccore { regulator-always-on; };
